{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native-platform.local/schemas/capability-result.schema.json",
  "type": "object",
  "required": ["capability_id", "request_id", "audit_id", "status"],
  "properties": {
    "capability_id": {"type": "string"},
    "request_id": {"type": "string"},
    "audit_id": {"type": "string"},
    "status": {"enum": ["succeeded", "failed"]},
    "result": {"type": "object"},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
